# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env

# Dados baixados/derivados (raw e processed nao vao pro git, so o .gitkeep)
data/raw/*
data/processed/*
sentiment/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/raw/**/.gitkeep
!sentiment/processed/.gitkeep

